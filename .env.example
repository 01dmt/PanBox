# TMDB v4 Read Access Token is preferred.
TMDB_API_TOKEN=

# A v3 API key also works when TMDB_API_TOKEN is empty.
TMDB_API_KEY=

# Optional overrides.
MEDIA_DB_PATH=data/media.db
# 127.0.0.1 = 仅本机访问；0.0.0.0 = 允许局域网/NAS 等其他设备访问
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8088

# 管理接口（接入 Key 设置）允许的客户端 IP/CIDR，逗号或空格分隔。
# 默认仅本机；NAS 局域网访问时追加实际网段，例如 10.10.10.0/24。
MEDIA_ADMIN_NETWORKS=127.0.0.1/32,::1/128

# Public resource API: callers must send X-API-Key.
MEDIA_API_KEY=change-this-to-a-long-random-key

# External raw-message ingestion webhook.
INGESTION_API_KEY=change-this-to-another-long-random-key

# Cookie and destination are configured in the local Settings page.
